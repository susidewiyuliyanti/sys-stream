// Prisma schema for Blind Box Deposit game
// PostgreSQL datasource and models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int              @id @default(autoincrement())
  cuid             String           @unique
  username         String           @unique
  email            String           @unique
  password         String
  balance          Int              @default(100000) // Saldo utama dan Game Balance (Rp)
  lockedSaldo      Int              @default(0) // Saldo yang sedang dikunci di Blind Box
  role             String           @default("USER") // USER, ADMIN
  isBlacklisted    Boolean          @default(false)
  forceJackpotNext Boolean          @default(false)
  createdAt        DateTime         @default(now())
  deposits         Deposit[]
  claims           BlindBoxClaim[]
  withdrawals      Withdrawal[]

  @@map("users")
}

model Deposit {
  id           Int              @id @default(autoincrement())
  depositCode  String           @unique
  userId       Int
  amount       Int              @default(50000) // 50000
  durationDays Int              // 30, 60, 90
  startDate    DateTime         @default(now())
  endDate      DateTime
  status       String           @default("ACTIVE") // ACTIVE, COMPLETED, EXPIRED
  totalClaimed Int              @default(0)
  forceJackpot Boolean          @default(false)
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  claims       BlindBoxClaim[]
  withdrawals  Withdrawal[]

  @@map("deposits")
}

model BlindBoxClaim {
  id         Int       @id @default(autoincrement())
  depositId  Int
  userId     Int
  claimDate  String    // Format YYYY-MM-DD (WIB)
  amount     Int       // 100 - 1000 atau 500000
  isJackpot  Boolean   @default(false)
  claimedAt  DateTime  @default(now())
  deposit    Deposit   @relation(fields: [depositId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([depositId, claimDate])
  @@map("blind_box_claims")
}

model GameSetting {
  id            Int      @id @default(autoincrement())
  jackpotAmount Int      @default(500000)
  jackpotChance Int      @default(100) // 1 banding 100 (50 - 1000)
  minBox        Int      @default(100)
  maxBox        Int      @default(1000)
  updatedAt     DateTime @default(now())

  @@map("game_settings")
}

model Withdrawal {
  id            Int      @id @default(autoincrement())
  userId        Int
  depositId     Int?
  amount        Int
  bankName      String   @default("BCA")
  accountNumber String
  accountName   String
  status        String   @default("COMPLETED")
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deposit       Deposit? @relation(fields: [depositId], references: [id], onDelete: Cascade)

  @@map("withdrawals")
}
