{
  "entities": {
    "users": {
      "title": "users",
      "description": "User profile and member subscription status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "streamerHandle": { "type": "string" },
        "bio": { "type": "string" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string" },
        "referralCount": { "type": "number" },
        "saldo": { "type": "number", "description": "Saldo terbuka aktif user dalam rupiah (tersedia)" },
        "walletBalance": { "type": "number", "description": "Saldo aktif user (sinkron dengan saldo)" },
        "lockedSaldo": { "type": "number", "description": "Saldo terkunci user (misal penarikan berstatus pending)" },
        "affiliateEarnings": { "type": "number" },
        "affiliateWithdrawn": { "type": "number" },
        "isSubscribed": { "type": "boolean" },
        "subscriptionPlan": { "type": "string" },
        "subscriptionExpiresAt": { "type": "string" },
        "role": { "type": "string" },
        "isLifetime": { "type": "boolean" },
        "isBanned": { "type": "boolean" },
        "bannedReason": { "type": "string" },
        "subscribedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "isSubscribed"]
    },
    "subscription_orders": {
      "title": "subscription_orders",
      "description": "Membership subscription transactions and records",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "price": { "type": "number" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "planId", "status"]
    },
    "vip_hosts": {
      "title": "vip_hosts",
      "description": "Whitelist of Sultan VIP Host accounts added by owner",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "addedBy": { "type": "string" },
        "addedAt": { "type": "string" },
        "role": { "type": "string" },
        "plan": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["email", "addedAt"]
    },
    "banned_users": {
      "title": "banned_users",
      "description": "Banned users and emails managed by owner susidewiyuliyanti@gmail.com",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "reason": { "type": "string" },
        "bannedBy": { "type": "string" },
        "bannedAt": { "type": "string" }
      },
      "required": ["email", "bannedAt"]
    },
    "admins": {
      "title": "admins",
      "description": "Admin accounts designated by owner susidewiyuliyanti@gmail.com",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "addedBy": { "type": "string" },
        "addedAt": { "type": "string" },
        "role": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["email", "addedAt"]
    },
    "system_settings": {
      "title": "system_settings",
      "description": "System-wide settings including Jackpot pool and odds",
      "type": "object",
      "properties": {
        "poolAmount": { "type": "number" },
        "winChance": { "type": "number" },
        "minBet": { "type": "number" },
        "forceNextUser": { "type": "string" },
        "forceNextNominal": { "type": "number" },
        "updatedAt": { "type": "string" }
      }
    },
    "jackpot_history": {
      "title": "jackpot_history",
      "description": "Records of jackpot winners and distributions",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "amount": { "type": "number" },
        "gameType": { "type": "string" },
        "wonAt": { "type": "string" }
      },
      "required": ["userId", "amount", "wonAt"]
    },
    "user_activities": {
      "title": "user_activities",
      "description": "Realtime activity stream across all users in the system",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["type", "userId", "title", "createdAt"]
    },
    "streaming_sessions": {
      "title": "streaming_sessions",
      "description": "Stream session history and logs recorded by host",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "streamTitle": { "type": "string" },
        "gameType": { "type": "string" },
        "totalRounds": { "type": "number" },
        "totalPrizeDistributed": { "type": "number" },
        "topWinner": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "startedAt": { "type": "string" },
        "endedAt": { "type": "string" }
      },
      "required": ["userId", "gameType", "startedAt"]
    },
    "referrals": {
      "title": "referrals",
      "description": "Referral record linking inviter and new streamer",
      "type": "object",
      "properties": {
        "referrerUid": { "type": "string" },
        "referrerEmail": { "type": "string" },
        "referredUid": { "type": "string" },
        "referredEmail": { "type": "string" },
        "referredName": { "type": "string" },
        "rewardAmount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["referrerUid", "referredUid", "status"]
    },
    "affiliate_withdrawals": {
      "title": "affiliate_withdrawals",
      "description": "Payout requests for affiliate earnings and referral rewards",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "amount": { "type": "number" },
        "bankName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "accountName": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "amount", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/users",
      "description": "Individual user document containing subscription status"
    },
    "/subscription_orders/{orderId}": {
      "schema": "#/entities/subscription_orders",
      "description": "Subscription order and payment records"
    },
    "/streaming_sessions/{sessionId}": {
      "schema": "#/entities/streaming_sessions",
      "description": "Stream broadcast session records and history"
    },
    "/referrals/{referralId}": {
      "schema": "#/entities/referrals",
      "description": "Referral and affiliate tracking documents"
    },
    "/affiliate_withdrawals/{withdrawalId}": {
      "schema": "#/entities/affiliate_withdrawals",
      "description": "Affiliate and referral commission withdrawal requests"
    },
    "/vip_hosts/{emailKey}": {
      "schema": "#/entities/vip_hosts",
      "description": "Whitelist document for Sultan VIP Host emails"
    },
    "/banned_users/{emailKey}": {
      "schema": "#/entities/banned_users",
      "description": "Banned emails registry"
    },
    "/admins/{emailKey}": {
      "schema": "#/entities/admins",
      "description": "Admin accounts designated by the owner"
    },
    "/system_settings/{settingId}": {
      "schema": "#/entities/system_settings",
      "description": "System settings including jackpot settings"
    },
    "/jackpot_history/{historyId}": {
      "schema": "#/entities/jackpot_history",
      "description": "Jackpot winners history"
    },
    "/user_activities/{activityId}": {
      "schema": "#/entities/user_activities",
      "description": "All user activities stream"
    }
  }
}
